#!/bin/bash
# AgentForeman.app 启动器
# 双击行为: 定位仓库根 -> 若服务未运行则后台启动 server.py -> 打开浏览器进入监工台。
# App 本身不常驻(LSUIElement)，服务进程独立于 App 存活；停止服务: pkill -f 'python3 .*server.py'

PORT=9527
URL="http://localhost:${PORT}"

alert() {
  /usr/bin/osascript -e "display alert \"Agent 监工台\" message \"$1\" as critical" >/dev/null 2>&1
}

# .app 位于仓库根: <repo>/AgentForeman.app/Contents/MacOS/AgentForeman
APP_BUNDLE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPO_DIR="$(dirname "${APP_BUNDLE}")"

if [ ! -f "${REPO_DIR}/server.py" ]; then
  alert "未找到 server.py。请保持 AgentForeman.app 位于 personal-agent-foreman 仓库根目录内，不要单独拷贝 App。"
  exit 1
fi

server_up() {
  /usr/bin/curl -s --max-time 1 "${URL}/api/state" >/dev/null 2>&1
}

if ! server_up; then
  if ! command -v python3 >/dev/null 2>&1; then
    alert "未找到 python3。请先安装 Xcode 命令行工具: xcode-select --install"
    exit 1
  fi
  /usr/bin/nohup python3 "${REPO_DIR}/server.py" >> "${REPO_DIR}/server.log" 2>&1 &
  # 等待就绪(最多 6 秒)
  for _ in $(seq 1 20); do
    sleep 0.3
    server_up && break
  done
  if ! server_up; then
    alert "服务启动失败，请查看仓库根目录下的 server.log(可能是端口 ${PORT} 被占用)。"
    exit 1
  fi
fi

/usr/bin/open "${URL}"
